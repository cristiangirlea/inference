{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(bash -n *)",
      "Bash(python -m py_compile *)",
      "Bash(sha256sum *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(git push *)",
      "Bash(scripts/serve.sh *)",
      "Bash(bash scripts/serve.sh *)",
      "Bash(huggingface-cli download *)",
      "Bash(hf download *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.cache/huggingface/token)"
    ]
  }
}
